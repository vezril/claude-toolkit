{
  "criteria": [
    "format",
    "preserve",
    "prune",
    "pointer",
    "disclosure",
    "steps",
    "positive"
  ],
  "main": "SKILL.md",
  "preserve": [
    {
      "id": "keep-a-changelog",
      "groups": [
        [
          "keep a changelog"
        ]
      ]
    },
    {
      "id": "four-groups",
      "groups": [
        [
          "added"
        ],
        [
          "changed"
        ],
        [
          "fixed"
        ],
        [
          "removed"
        ]
      ]
    },
    {
      "id": "since-last-tag",
      "groups": [
        [
          "tag"
        ]
      ]
    },
    {
      "id": "no-merge-commits",
      "groups": [
        [
          "merge commit",
          "no-merges",
          "merges"
        ]
      ]
    },
    {
      "id": "breaking-first-and-why",
      "groups": [
        [
          "breaking"
        ],
        [
          "search",
          "scan",
          "look for",
          "grep"
        ]
      ]
    },
    {
      "id": "monorepo-mapping",
      "groups": [
        [
          "scope"
        ],
        [
          "billing-api"
        ],
        [
          "client-sdk"
        ],
        [
          "infra"
        ]
      ]
    }
  ],
  "prune": [
    {
      "id": "role-no-op",
      "pattern": "expert technical writer|years of experience",
      "max": 0
    },
    {
      "id": "thorough-no-op",
      "pattern": "be thorough",
      "max": 0
    },
    {
      "id": "make-sure-no-op",
      "pattern": "make sure to",
      "max": 0
    },
    {
      "id": "keep-a-changelog-duplicate",
      "pattern": "(follow\\w*|conform\\w*|according to|adher\\w*)\\s+(to\\s+)?(the\\s+)?keep a changelog|keep a changelog (format|spec|1\\.1)",
      "max": 1
    }
  ],
  "pointer": {
    "maxWords": 45,
    "lead": "changelog",
    "branches": [
      {
        "id": "monorepo",
        "pattern": "monorepo|per.package|package"
      }
    ],
    "synonyms": {
      "distinct": [
        "change ?logs?|changelog\\.md",
        "release notes",
        "version history",
        "history of changes"
      ],
      "max": 2
    },
    "identity": "^(this|a|the) skill\\b|\\bis a skill\\b|helps you"
  },
  "disclosure": {
    "marker": "billing-api"
  },
  "steps": {
    "min": 3
  },
  "positive": [
    {
      "id": "passive-voice",
      "banned": "(don'?t|do not|never|avoid)[^.\\n]{0,20}passive",
      "want": "active (voice|verb)|start(s|ing)? with (a|an) (active )?verb|imperative"
    }
  ]
}
