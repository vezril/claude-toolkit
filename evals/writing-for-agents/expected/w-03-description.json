{
  "criteria": [
    "format",
    "pointer"
  ],
  "descriptionOnly": true,
  "pointer": {
    "maxWords": 45,
    "lead": "release notes|what'?s new",
    "branches": [
      {
        "id": "draft",
        "pattern": "draft|writ|git|commits|merged"
      },
      {
        "id": "translate",
        "pattern": "translat|locali[sz]|locale"
      },
      {
        "id": "limit",
        "pattern": "limit|shorten|trim|cut|fit|character"
      }
    ],
    "synonyms": {
      "distinct": [
        "release notes",
        "what'?s new",
        "change ?logs?",
        "patch notes",
        "update notes",
        "version notes"
      ],
      "max": 2
    },
    "identity": "^(this|a|the) skill\\b|\\bis a skill\\b|helps you|^use this skill"
  }
}
