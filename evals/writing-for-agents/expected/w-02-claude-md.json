{
  "criteria": [
    "format",
    "preserve",
    "prune",
    "positive"
  ],
  "main": "CLAUDE.md",
  "preserve": [
    {
      "id": "legacy-gateway-and-why",
      "groups": [
        [
          "legacy-gateway"
        ],
        [
          "ledger"
        ]
      ]
    },
    {
      "id": "utc-formatlocal",
      "groups": [
        [
          "utc"
        ],
        [
          "formatlocal"
        ]
      ]
    },
    {
      "id": "main-branch-guardrail",
      "groups": [
        [
          "main"
        ],
        [
          "commit",
          "push",
          "branch",
          "pull request",
          "pr ",
          "prs"
        ]
      ]
    },
    {
      "id": "no-any",
      "groups": [
        [
          "`any`",
          "unknown",
          " any ",
          "precise",
          "explicit type"
        ]
      ]
    },
    {
      "id": "named-exports",
      "groups": [
        [
          "export"
        ]
      ]
    }
  ],
  "prune": [
    {
      "id": "dev-command-cache",
      "pattern": "npm run dev|next dev",
      "max": 0
    },
    {
      "id": "install-command-cache",
      "pattern": "npm install",
      "max": 0
    },
    {
      "id": "layout-cache",
      "pattern": "contains (the )?(routes|react components|utilities|static assets)",
      "max": 0
    },
    {
      "id": "clean-code-no-op",
      "pattern": "good, clean code|clean code",
      "max": 0
    }
  ],
  "positive": [
    {
      "id": "any",
      "banned": "(don'?t|do not|never|avoid)\\s+(use\\s+)?`?any`?\\b",
      "want": "unknown|explicit (type|types)|precise(ly)?|type (everything|every)|real type|proper type"
    },
    {
      "id": "default-exports",
      "banned": "(don'?t|do not|never|avoid)\\s+(use\\s+)?default exports?",
      "want": "named exports?"
    }
  ],
  "guardrails": [
    {
      "id": "main",
      "if": "never (commit|push)[^.\\n]{0,30}main",
      "want": "branch|pull request|PR\\b"
    }
  ]
}
