diff --git a/db/migrations/0042_drop_recipe_legacy_notes.sql b/db/migrations/0042_drop_recipe_legacy_notes.sql
new file mode 100644
index 0000000..7c1d2e4
--- /dev/null
+++ b/db/migrations/0042_drop_recipe_legacy_notes.sql
@@ -0,0 +1,9 @@
+-- Notes now live in recipe_notes (one row per note, with author and timestamp).
+-- Copy the old free-text column across, then drop it.
+INSERT INTO recipe_notes (recipe_id, body, author_id, created_at)
+SELECT id, legacy_notes, owner_id, updated_at
+FROM recipes
+WHERE legacy_notes IS NOT NULL AND legacy_notes <> '';
+
+ALTER TABLE recipes DROP COLUMN legacy_notes;
+
