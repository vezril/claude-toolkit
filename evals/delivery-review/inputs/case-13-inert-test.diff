diff --git a/src/pipeline.py b/src/pipeline.py
index aaa1111..bbb2222 100644
--- a/src/pipeline.py
+++ b/src/pipeline.py
@@ -120,6 +120,12 @@ class Pipeline:
+    def finish(self, run_id, owner):
+        if self.rows.owner_of(run_id) == owner:
+            self.rows.update(run_id, state="complete")
+            return True
+        return False
+
