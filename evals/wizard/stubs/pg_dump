#!/usr/bin/env bash
# Eval stub: logs the call and writes a small non-empty dump (to -f/--file, else stdout).
echo "CMD pg_dump $*" >> "$WIZARD_LOG"
out=""; prev=""
for a in "$@"; do
  [[ "$prev" == "-f" || "$prev" == "--file" ]] && out="$a"
  [[ "$a" == --file=* ]] && out="${a#--file=}"
  prev="$a"
done
if [[ -n "$out" ]]; then printf -- '-- stub dump\nCREATE TABLE recipes_v1 ();\n' > "$out"; else printf -- '-- stub dump\nCREATE TABLE recipes_v1 ();\n'; fi
