{
  "artifact": "outcome.json",
  "produced_by": "report",
  "consumed_by": [],
  "counts": {"manual_corrections": "manual_corrections[]"},
  "consumers": {},
  "type": "object",
  "required": ["item", "profile", "status", "step", "ts", "manual_corrections"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed", "punched-out", "failed", "abandoned"]},
    "reason": {"type": ["string", "null"]},
    "step": {"type": "string", "minLength": 1},
    "ts": {"type": "string", "minLength": 1},
    "manual_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "traced_sha256", "actual_sha256"],
        "additionalProperties": false,
        "properties": {
          "artifact": {"type": "string", "minLength": 1},
          "traced_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "actual_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
