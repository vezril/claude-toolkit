{
  "artifact": "breakdown.json",
  "produced_by": "breakdown",
  "consumed_by": ["challenge-breakdown", "implementation"],
  "counts": {
    "epics": "epics[]",
    "stories": "epics[].stories[]",
    "acceptance_criteria": "epics[].stories[].acceptance_criteria[]"
  },
  "consumers": {
    "challenge-breakdown": {"requires": ["item", "epics"]},
    "implementation": {"requires": ["item", "epics"]}
  },
  "type": "object",
  "required": ["item", "epics"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "minLength": 1},
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "stories"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "statement", "acceptance_criteria", "domains"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^S[0-9]+$"},
                "statement": {"type": "string", "minLength": 1},
                "domains": {"type": "array", "items": {"type": "string"}},
                "acceptance_criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "given", "when", "then"],
                    "additionalProperties": false,
                    "properties": {
                      "id": {"type": "string", "pattern": "^AC[0-9]+$"},
                      "given": {"type": "string", "minLength": 1},
                      "when": {"type": "string", "minLength": 1},
                      "then": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
