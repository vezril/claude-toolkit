{
  "artifact": "proposal.json",
  "produced_by": "propose",
  "consumed_by": ["implementation", "brief"],
  "counts": {
    "tasks": "tasks[]",
    "specs_touched": "specs_touched[]",
    "dependencies_added": "dependencies_added[]"
  },
  "consumers": {
    "implementation": {"requires": ["item", "change_id", "change_path", "tasks"]},
    "brief": {"requires": ["item", "change_id", "tasks"]}
  },
  "type": "object",
  "required": ["item", "change_id", "change_path", "specs_touched", "tasks",
               "dependencies_added", "scope", "architecture", "breaking"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "change_path": {"type": "string", "minLength": 1},
    "specs_touched": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "files"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]+$"},
          "description": {"type": "string", "minLength": 1},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "dependencies_added": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "boolean"},
    "architecture": {"type": "boolean"},
    "breaking": {"type": "boolean"}
  }
}
