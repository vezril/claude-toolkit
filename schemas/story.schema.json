{
  "artifact": "story.json",
  "produced_by": "render-stories",
  "consumed_by": ["test-writer", "implementer"],
  "counts": {"acceptance_criteria": "acceptance_criteria[]", "sources": "sources[]"},
  "consumers": {
    "test-writer": {"requires": ["item", "story", "statement", "acceptance_criteria", "sources"]},
    "implementer": {"requires": ["item", "story", "statement", "acceptance_criteria", "sources"]}
  },
  "type": "object",
  "required": ["item", "epic", "story", "statement", "domains", "acceptance_criteria",
               "sources", "ordering"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "minLength": 1},
    "epic": {"type": "string", "pattern": "^E[0-9]+$"},
    "story": {"type": "string", "pattern": "^S[0-9]+$"},
    "statement": {"type": "string", "minLength": 1},
    "domains": {
      "type": "array",
      "items": {"type": "string",
                "enum": ["ux", "frontend", "backend", "contracts", "infra", "data",
                         "mobile", "docs"]}
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^AC[0-9]+$"},
          "given": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "then": {"type": "string", "minLength": 1}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "ordering": {
      "type": "object",
      "required": ["determined", "position", "basis"],
      "additionalProperties": false,
      "properties": {
        "determined": {"type": "boolean"},
        "position": {"type": "integer"},
        "basis": {"type": "string", "minLength": 1}
      }
    }
  }
}
