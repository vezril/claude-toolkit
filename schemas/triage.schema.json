{
  "artifact": "triage.json",
  "produced_by": "triage",
  "consumed_by": ["breakdown", "policy-check"],
  "counts": {"domains": "domains[]"},
  "consumers": {
    "breakdown": {"requires": ["item", "type", "path", "summary"]},
    "policy-check": {"requires": ["handoff", "architecture_change", "breaking_change"]}
  },
  "type": "object",
  "required": ["item", "type", "path", "domains", "summary", "rationale",
               "handoff", "architecture_change", "breaking_change"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["bug", "feature", "task"]},
    "path": {"type": "string", "enum": ["quick", "standard"]},
    "domains": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "handoff": {"type": "boolean"},
    "handoff_reason": {"type": ["string", "null"]},
    "architecture_change": {"type": "boolean"},
    "breaking_change": {"type": "boolean"}
  }
}
